    {
      "id": "spotify.k1",
      "group": "spotify",
      "label": "Play/Pause",
      "icon": "⏯",
      "action": {
        "script": "tell application \"Spotify\" to playpause",
        "type": "applescript"
      },
      "about": "Play or pause Spotify."
    },
    {
      "id": "spotify.k2",
      "group": "spotify",
      "label": "Previous",
      "icon": "⏮",
      "action": {
        "script": "tell application \"Spotify\" to previous track",
        "type": "applescript"
      },
      "about": "Previous track."
    },
    {
      "id": "spotify.k3",
      "group": "spotify",
      "label": "Next",
      "icon": "⏭",
      "action": {
        "script": "tell application \"Spotify\" to next track",
        "type": "applescript"
      },
      "about": "Next track."
    },
    {
      "id": "spotify.k4",
      "group": "spotify",
      "label": "Shuffle",
      "icon": "🔀",
      "action": {
        "script": "tell application \"Spotify\" to set shuffling to not shuffling",
        "type": "applescript"
      },
      "about": "Toggles shuffle."
    },
    {
      "id": "spotify.k5",
      "group": "spotify",
      "label": "Repeat",
      "icon": "🔁",
      "action": {
        "script": "tell application \"Spotify\" to set repeating to not repeating",
        "type": "applescript"
      },
      "about": "Toggles repeat."
    },
    {
      "id": "spotify.k6",
      "group": "spotify",
      "label": "Vol -6 / +6",
      "icon": "🔊",
      "action": {
        "script": "set v to output volume of (get volume settings)\nif v > 0 then\n  set volume output volume (v - 6)\nelse\n  set volume output volume 55\nend if",
        "type": "applescript"
      },
      "about": "Volume down 6; at zero, back to 55."
    },
