      },
      "about": "Opens the Downloads folder."
    },
    {
      "id": "mac.k5",
      "group": "mac",
      "label": "Empty trash",
      "icon": "🗑",
      "action": {
        "script": "tell application \"Finder\"\n  empty trash\n  return \"trash emptied\"\nend tell",
        "type": "applescript"
      },
      "about": "Empties the Mac's Trash. Cannot be undone."
    },
    {
      "id": "mac.k6",
      "group": "mac",
      "label": "Terminal",
      "icon": "▮",
      "action": {
        "script": "tell application \"Terminal\" to activate",
        "type": "applescript"
      },
      "about": "Brings Terminal to the front."
    },
