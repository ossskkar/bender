{
  "_comment": "Arisu's deck: the buttons the iPad presses on the Mac. Seeded from the retired macropad's bindings (2026-09-26). Port 8887 because the Mac's existing `tailscale serve :8443` already proxies there -- it pointed at a dead port, so the iPad reaches the deck with no new serve rule.",
  "port": 8887,
  "buttons": [
    {
      "id": "claude-code.k7",
      "group": "claude-code",
      "label": "away",
      "icon": "✈",
      "action": {
        "type": "compound",
        "steps": [
          {
            "type": "text",
            "text": "/away",
            "paste": true
          },
          {
            "type": "keys",
            "keys": "return"
          }
        ]
      },
      "about": "Types /away: Claude works on without asking you."
    },
    {
      "id": "claude-code.k3",
      "group": "claude-code",
      "label": "continue",
      "icon": "▶",
      "action": {
        "steps": [
          {
            "type": "text",
            "text": "continue",
            "paste": true
          },
          {
            "keys": "return",
            "type": "keys"
          }
        ],
        "type": "compound"
      },
      "about": "Types continue and sends it."
    },
    {
      "id": "claude-code.k5",
      "group": "claude-code",
      "label": "screenshot",
      "icon": "📷",
      "action": {
        "steps": [
          {
            "cmd": "screencapture -i -c",
            "type": "shell"
          },
          {
            "keys": "cmd+v",
            "type": "keys"
          }
        ],
        "type": "compound"
      },
      "about": "Lets you pick a screen area, then pastes the capture into Claude."
    },
    {
      "id": "claude-code.recap",
      "group": "claude-code",
      "label": "recap",
      "icon": "",
      "about": "Types /recap: a short structured recap of the last message and where things stand.",
      "action": {
        "type": "compound",
        "steps": [
          {
            "type": "text",
            "text": "/recap",
            "paste": true
          },
          {
            "type": "keys",
            "keys": "return"
          }
        ]
      }
    },
    {
      "id": "claude-code.explain",
      "group": "claude-code",
      "label": "explain",
      "icon": "",
      "about": "Types /explain: a clear, short explanation of the previous message.",
      "action": {
        "type": "compound",
        "steps": [
          {
            "type": "text",
            "text": "/explain",
            "paste": true
          },
          {
            "type": "keys",
            "keys": "return"
          }
        ]
      }
    },
    {
      "id": "claude-code.guide",
      "group": "claude-code",
      "label": "guide",
      "icon": "",
      "about": "Types /guide: every step you must do, numbered, with exact actions.",
      "action": {
        "type": "compound",
        "steps": [
          {
            "type": "text",
            "text": "/guide",
            "paste": true
          },
          {
            "type": "keys",
            "keys": "return"
          }
        ]
      }
    },
    {
      "id": "claude-code.k2",
      "group": "claude-code",
      "label": "clear",
      "icon": "✳",
      "action": {
        "steps": [
          {
            "type": "text",
            "text": "/clear",
            "paste": true
          },
          {
            "keys": "return",
            "type": "keys"
          }
        ],
        "type": "compound"
      },
      "about": "Types /clear: starts a fresh conversation."
    },
    {
      "id": "claude-code.k1",
      "group": "claude-code",
      "label": "handoff",
      "icon": "⇥",
      "action": {
        "steps": [
          {
            "type": "text",
            "text": "/handoff",
            "paste": true
          },
          {
            "keys": "return",
            "type": "keys"
          }
        ],
        "type": "compound"
      },
      "about": "Types /handoff: saves the session state to HANDOFF.md."
    },
    {
      "id": "mac.k1",
      "group": "mac",
      "label": "Lock screen",
      "icon": "🔒",
      "action": {
        "keys": "ctrl+cmd+q",
        "type": "keys"
      },
      "about": "Locks the Mac (ctrl+cmd+Q)."
    },
    {
      "id": "mac.k2",
      "group": "mac",
      "label": "Sleep screen",
      "icon": "☾",
      "action": {
        "cmd": "pmset displaysleepnow",
        "type": "shell"
      },
      "about": "Turns the Mac's display off."
    },
    {
      "id": "mac.k3",
      "group": "mac",
      "label": "Screenshot",
      "icon": "▣",
