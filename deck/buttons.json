    {
      "id": "hermes.k1",
      "group": "hermes",
      "label": "Chat",
      "icon": "💬",
      "action": {
        "script": "tell application \"Terminal\"\n  activate\n  do script \"ssh -t architect '~/.local/bin/hermes chat'\"\nend tell",
        "type": "applescript"
      },
      "about": "Opens a Hermes chat in Terminal."
    },
    {
      "id": "hermes.k2",
      "group": "hermes",
      "label": "Status",
      "icon": "◉",
      "action": {
        "cmd": "ssh -o ConnectTimeout=8 architect '~/.local/bin/hermes status'",
        "type": "shell"
      },
      "about": "Shows Hermes status."
    },
    {
      "id": "hermes.k3",
      "group": "hermes",
      "label": "Logs",
      "icon": "📜",
      "action": {
        "script": "tell application \"Terminal\"\n  activate\n  do script \"ssh -t architect '~/.local/bin/hermes logs -f'\"\nend tell",
        "type": "applescript"
      },
      "about": "Follows Hermes logs in Terminal."
    },
    {
      "id": "hermes.k4",
      "group": "hermes",
      "label": "Restart",
      "icon": "⟳",
      "action": {
        "cmd": "ssh -o ConnectTimeout=8 architect '~/.local/bin/hermes gateway restart'",
        "type": "shell"
      },
      "about": "Restarts the Hermes gateway."
    },
    {
      "id": "hermes.k5",
      "group": "hermes",
      "label": "Gateway",
      "icon": "⇄",
      "action": {
        "cmd": "ssh -o ConnectTimeout=8 architect '~/.local/bin/hermes gateway status'",
