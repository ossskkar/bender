# Xcode per-user state: window layout, breakpoints, the last scheme run. Noise
# in a diff, and it changes on every build.
native/**/xcuserdata/
native/**/*.xcuserstate
native/build/
DerivedData/
.DS_Store

# Third-party Live2D runtime, cloned not vendored. Re-clone with:
#   git clone --depth 1 https://github.com/Live2D/CubismWebSamples.git live2d/CubismWebSamples
# Its Core/ is empty by design -- the three live2dcubismcore.* files are
# licence-gated and must be downloaded from Live2D by hand.
live2d/CubismWebSamples/
