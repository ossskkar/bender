# Xcode per-user state: window layout, breakpoints, the last scheme run. Noise
# in a diff, and it changes on every build.
native/**/xcuserdata/
native/**/*.xcuserstate
native/build/
DerivedData/
.DS_Store

# Third-party Live2D runtime, not vendored. It is the unpacked
# CubismSdkForWeb-5-r.5.zip, which is licence-gated: download it yourself from
# https://www.live2d.com/download/cubism-sdk/download-web/ and unpack it to
# live2d/CubismSdkForWeb. Do not use the CubismWebSamples GitHub repo instead --
# it ships neither Core nor the Framework submodule, and will not build.
live2d/CubismSdkForWeb/
